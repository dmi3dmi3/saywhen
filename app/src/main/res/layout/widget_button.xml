<?xml version="1.0" encoding="utf-8"?>
<!-- плитка на всю ячейку (19d): фон — акцент палитры (31+) или чернила,
     плюс — крупный вектор по центру; тап — вся ячейка -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/widget_label">

    <!-- инсет-плитка (итерации фидбека владельца): ячейка минус равные поля —
         геометрию задаёт лаунчер, выравниванию нечему съезжать; тон
         контейнерный (масса — это насыщенность), акцент несёт плюс -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="8dp"
        android:background="@drawable/widget_background">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_plus" />
    </FrameLayout>
</FrameLayout>
